{
  "name": "cascabel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Biblioteca libre de actividades de música para Educación Infantil y Primaria",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node tools/comprobar-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contenido:preparar": "node tools/preparar.mjs",
    "contenido:validar": "node tools/validar.mjs content/actividades",
    "contenido:indice": "node tools/indice.mjs",
    "docs:tipos": "node tools/tabla-tipos.mjs",
    "docs:pendientes": "node tools/pendientes.mjs",
    "comprobar:produccion": "node tools/comprobar-produccion.mjs",
    "verificar": "npm run typecheck && npm run lint && npm run test && npm run contenido:validar"
  },
  "dependencies": {
    "abcjs": "6.7.0",
    "pitchy": "4.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.6.3",
    "tone": "15.1.22",
    "vexflow": "5.0.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.17.0",
    "globals": "^15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarruego/cascabel.git"
  },
  "homepage": "https://github.com/jarruego/cascabel#readme",
  "bugs": {
    "url": "https://github.com/jarruego/cascabel/issues"
  }
}
