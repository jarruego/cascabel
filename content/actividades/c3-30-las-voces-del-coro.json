  "contenido": {
    "consigna": "actividad.c330.consigna",
    "instrumento": "voz",
    "secciones": [
      {
        "titulo": "Las voces de mujer y de niño",
        "entradas": [
          {
            "termino": "Soprano",
            "explicacion": "La voz más aguda. Es la de casi todos los niños y niñas de Primaria, y la que suele llevar la melodía en un coro.",
            "notas": [
              "C5",
              "D5",
              "E5",
              "D5",
              "C5"
            ]
          },
          {
            "termino": "Contralto",
            "explicacion": "La voz grave de mujer. Va por debajo de la soprano y rellena la armonía.",
            "notas": [
              "G4",
              "A4",
              "B4",
              "A4",
              "G4"
            ]
          }
        ]
      },
      {
        "titulo": "Las voces de hombre",
        "entradas": [
          {
            "termino": "Tenor",
            "explicacion": "La voz aguda de hombre. Canta una octava por debajo de la soprano, y por eso muchas melodías les valen a los dos.",
            "notas": [
              "C4",
              "D4",
              "E4",
              "D4",
              "C4"
            ]
          },
          {
            "termino": "Bajo",
            "explicacion": "La voz más grave que hay. Sostiene el coro desde abajo, como el bombo sostiene una banda.",
            "notas": [
              "C3",
              "D3",
              "E3",
              "D3",
              "C3"
            ]
          }
        ]
      },
      {
        "titulo": "Y las cuatro juntas",
        "entradas": [
          {
            "termino": "Coro a cuatro voces",
            "explicacion": "Un acorde, de abajo arriba: bajo, tenor, contralto y soprano. Cada voz canta una nota distinta y suenan a la vez.",
            "notas": [
              "C3",
              "G3",
              "E4",
              "C5"
            ],
            "duraciones": [
              0.5,
              0.5,
              0.5,
              2
            ]
          }
        ]
      }
    ]
  },
