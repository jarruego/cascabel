{
  "name": "Cascabel",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/app",
  "forwardPorts": [5173],
  "postCreateCommand": "npm install && pip3 install --break-system-packages -r tools/requirements.txt || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "vitest.explorer"
      ]
    }
  }
}
