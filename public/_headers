# Cabeceras para Cloudflare Pages. Replican infra/nginx.conf.
# connect-src 'self' es lo que hace TECNICAMENTE imposible exfiltrar el audio del
# microfono, y por tanto lo que nos permite prometerlo por escrito.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin

/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable
